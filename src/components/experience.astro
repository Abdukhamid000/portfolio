---
const roles = [
  {
    company: "Longhorn Logistics Group",
    role: "Frontend Developer",
    dates: "Jan 2025 – Sep 2026",
    location: "Tashkent, Uzbekistan",
    detail:
      "Built fleet-tracking features and data-heavy interfaces with React and TypeScript; modernized a legacy logistics application and maintained component tests.",
  },
  {
    company: "Freelance",
    role: "Frontend Developer",
    dates: "Mar 2024 – Jan 2025",
    location: "Tashkent, Uzbekistan",
    detail:
      "Delivered Vue.js and TypeScript applications, including a school management system with role-based access, attendance, and student performance features.",
  },
  {
    company: "Vention",
    role: "Full Stack Developer Intern",
    dates: "May 2024 – Jul 2024",
    location: "Tashkent, Uzbekistan",
    detail:
      "Learned backend development with Node.js, Express.js, and NestJS; built REST APIs and worked on routing, middleware, and basic authentication.",
  },
  {
    company: "UIC Group",
    role: "Frontend Developer",
    dates: "Feb 2023 – Mar 2024",
    location: "Tashkent, Uzbekistan",
    detail:
      "Developed lending applications and responsive landing pages, with a focus on frontend performance, Core Web Vitals, and SEO.",
  },
];
---

<section
  id="experience"
  class="py-16 border-t border-[#ffffff10] text-[var(--white)]"
>
  <div class="max-w-5xl mx-auto">
    <p class="text-lg text-[var(--sec)] mb-2 shiny-sec">Where I've worked</p>
    <h2 class="text-4xl md:text-5xl font-medium mb-9">Experience</h2>
    <ol class="grid gap-4 md:grid-cols-2">
      {
        roles.map((item) => (
          <li class="rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-5 md:p-6">
            <div class="mb-4 flex flex-wrap items-start justify-between gap-2">
              <div>
                <h3 class="text-xl font-semibold">{item.company}</h3>
                <p class="mt-1 text-[var(--sec)]">{item.role}</p>
              </div>
              <span class="text-sm text-[var(--white-icon)]">{item.dates}</span>
            </div>
            <p class="mb-3 text-xs text-[var(--white-icon)]">{item.location}</p>
            <p class="text-sm leading-6 text-[var(--white-icon)]">{item.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
